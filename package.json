{
  "name": "zhiyin-codelab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "licenses:collect": "node scripts/audit-dependency-licenses.mjs",
    "dev:workspace:supervised": "tsx scripts/launch-workspace.ts",
    "workspace:runtime": "tsx scripts/launch-workspace.ts --check",
    "retention:check": "tsx scripts/check-retention.ts",
    "retention:hold": "tsx scripts/retention-hold.ts",
    "retention:source": "tsx scripts/source-retention.ts",
    "retention:course-plan": "tsx scripts/course-retention-plan.ts",
    "retention:course": "tsx scripts/course-retention.ts",
    "evaluation:check": "tsx scripts/check-evaluation.ts",
    "backup:archive": "tsx scripts/archive-backup.ts",
    "reproduction:package": "tsx scripts/package-reproduction.ts",
    "model:check": "node --import tsx --env-file-if-exists=.env scripts/verify-model.ts",
    "storage:check": "tsx scripts/check-storage.ts",
    "dev": "concurrently -k \"pnpm --filter @codelab/api dev\" \"pnpm --filter @codelab/web dev\"",
    "build": "pnpm --filter @codelab/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:coursework": "playwright test --config=playwright.coursework.config.ts",
    "verify:coursework:git": "tsx scripts/verify-coursework-git.ts",
    "verify:coursework:public-flow": "tsx scripts/verify-coursework-public-flow.ts",
    "verify:coursework:restore": "tsx scripts/verify-coursework-restore.ts",
    "verify:coursework:corpus": "tsx scripts/check-coursework-corpus.ts",
    "evaluate:coursework": "tsx scripts/evaluate-coursework-live.ts",
    "review:coursework:prepare": "tsx scripts/prepare-coursework-review.ts",
    "measure:coursework": "tsx scripts/measure-coursework.ts",
    "test:e2e:v2": "playwright test --config=playwright.v2.config.ts && playwright test --config=playwright.review-recovery.config.ts && playwright test --config=playwright.review-write.config.ts && playwright test --config=playwright.source.config.ts && playwright test --config=playwright.login.config.ts && playwright test --config=playwright.source-flow.config.ts",
    "test:e2e:source-flow": "playwright test --config=playwright.source-flow.config.ts",
    "verify:services": "tsx scripts/smoke-services.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "db:migrate": "pnpm --filter @codelab/api migrate",
    "db:seed": "pnpm --filter @codelab/api seed",
    "worker": "pnpm --filter @codelab/api worker",
    "runner": "tsx --env-file-if-exists=.env apps/runner/src/server.ts",
    "runner:v2": "tsx --env-file-if-exists=.env apps/runner/src/server-v2.ts",
    "runner:desktop": "tsx scripts/desktop-runner.ts",
    "verify:desktop:v2": "tsx scripts/verify-desktop-v2.ts",
    "verify:reaper": "tsx scripts/verify-reaper-faults.ts",
    "worker:v2": "tsx --env-file-if-exists=.env apps/api/src/worker-v2.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "dev:local": "concurrently -k \"tsx scripts/local.ts\" \"pnpm --filter @codelab/web dev\"",
    "dev:workspace": "tsx scripts/launch-workspace.ts --direct"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.1.2",
    "fflate": "0.8.2",
    "prettier": "3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
