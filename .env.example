DATABASE_URL=postgres://codelab:codelab_local@127.0.0.1:5433/codelab
APP_ORIGIN=http://localhost:5173
API_PORT=3100
API_HOST=127.0.0.1
DATA_DIR=.data
COOKIE_SECURE=false
# 默认关闭；Docker Desktop 开发验证仅限获准团队样本，真实学生入口仍需系统验收。
EXECUTION_APPROVED=false
# 本机开发可用此占位地址；部署worker在容器时必须改为专用执行机的受限地址。
RUNNER_URL=http://127.0.0.1:3200
RUNNER_TOKEN=replace-with-at-least-32-random-characters
EXECUTION_IMAGE=codelab-build:vue-board-v1
# 以下仅在专用Linux执行机配置；true只允许启动，验收记录仍需独立完成。
RUNNER_APPROVED=false
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3200
RUNNER_DATA_DIR=/var/lib/codelab-runner
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 可选，0—2；空值不发送该参数，不能将服务端默认温度写成已固定。
MODEL_TEMPERATURE=
# 源码分析专用。窗口大小须按实际供应商/模型填写；空值保持未知。
SOURCE_MODEL_CONTEXT_TOKENS=
# 为输出预留的上限，默认12000；按模型能力调整，不能超过实际输出限制。
SOURCE_MODEL_MAX_OUTPUT_TOKENS=12000
# 未确认分词器时保持utf8-conservative；明确匹配后才选cl100k_base/o200k_base。
SOURCE_MODEL_TOKENIZER=utf8-conservative
# 阅读增强仅复用既有合成/复核请求。真实模型与人工评测通过前保持0；不回填历史报告。
SOURCE_READING_BRIEF=0
# 独立展示回退；设置0后重新构建前端，隐藏增强用途与问题指导，原数据保留。
VITE_READING_BRIEF=1
# 新运行的首次分析：off=结构化报告，summary=单次总结，agent=受限Agent（默认）。
# 新运行入队时固定；已排队项不随重启切换。显式重新分析可选择总结或Agent。
CODELAB_INITIAL_ANALYSIS_MODE=agent
SEED_PASSWORD=
## Keep legacy business writes during staged development; switch to 2 only with the v2 workbench.
BUSINESS_API_VERSION=1
# v2: pnpm runner:desktop up 生成。API 与 worker:v2 共用同一真实测量目录。
CODELAB_V2_RUNTIME_FILE=
# worker:v2 证据路径须与 API 的 DATA_DIR/evidence-v2 完全相同。
ARTIFACT_ROOT=
